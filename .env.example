# Hosted-mode deployment env vars. Copy to `.env` and fill in.
# Used by docker-compose.yml. See README → Hosted mode for the full matrix.

# --- Required ---

# The eLabFTW instance users register against. Hosted mode only ever
# talks to instances on an explicit allow-list: this URL, or the list in
# MCP_ALLOWED_BASE_URLS below. The server refuses to start without one.
ELABFTW_BASE_URL=https://elab.example.com

# Bare hostname Caddy auto-provisions a Let's Encrypt cert for.
# DNS A/AAAA record for this name must point at this host.
MCP_DOMAIN=mcp.example.tum.de

# Public origin used in the personal MCP URL the registration page
# returns, and the source of the Host/Origin allow-list. Should be the
# https origin matching MCP_DOMAIN. Required by docker-compose.yml.
MCP_PUBLIC_URL=https://mcp.example.tum.de

# --- Strongly recommended ---

# 32-byte key that encrypts the stored eLabFTW API keys (AES-256-GCM).
# Generate with `openssl rand -base64 32`. If unset, the server generates
# one into `<MCP_REGISTRATIONS_PATH>.key` on the data volume and logs a
# warning — back that file up, or the stored keys become unreadable.
# Changing this key later makes existing registrations undecryptable.
# MCP_STORE_KEY=

# --- Optional ---

# More than one eLabFTW instance? Comma-separated allow-list; the
# register / manage pages then show a picker. Overrides ELABFTW_BASE_URL
# as the allow-list (ELABFTW_BASE_URL stays the default).
# MCP_ALLOWED_BASE_URLS=https://elab.example.com,https://elab2.example.com

# Operator-level permission caps. Users opt in per token on /register;
# a per-token flag only takes effect when its cap here is on too.
# ELABFTW_ALLOW_WRITES=false
# ELABFTW_ALLOW_DESTRUCTIVE=false
# ELABFTW_REVEAL_USER_IDENTITIES=false

# Override the auto-derived Host/Origin allow-list. Comma-separated.
# Default: derived from MCP_PUBLIC_URL. Set this only if you need to
# accept additional Host / Origin header values.
# MCP_ALLOWED_HOSTS=mcp.example.tum.de,mcp.staging.example.tum.de
# MCP_ALLOWED_ORIGINS=https://mcp.example.tum.de,https://app.example.tum.de

# Number of reverse-proxy hops to trust for client IP / https detection.
# 1 = Caddy only (default). 0 = app exposed directly.
# MCP_TRUST_PROXY=1

# Resource limits.
# MCP_MAX_SESSIONS=500            # live MCP sessions, all tokens (LRU-evicted)
# MCP_MAX_SESSIONS_PER_TOKEN=5    # live MCP sessions per token (LRU-evicted)
# MCP_MAX_TOKENS_PER_USER=20      # tokens per eLabFTW user per instance

# Pick a registration store backend.
#   json    — atomic-write JSON file (default; fine to a few hundred
#             tokens; single server process only)
#   sqlite  — better-sqlite3 with WAL + indexed (userid, base_url) lookups
#             (recommended for institutional scale)
# When using sqlite, point MCP_REGISTRATIONS_PATH at a `.db` file under
# the same volume mount.
# MCP_STORE_BACKEND=json
# MCP_REGISTRATIONS_PATH=/var/lib/elabftw-mcp/registrations.json
